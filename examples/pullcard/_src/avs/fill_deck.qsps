# crc_fill_deck
! Создаём коллоду. Для этого заполняем массив текстовыми значениями.

! Можно просто написать код типа:

! $deck[0] = 'двойка треф'
! $deck[1] = 'тройка треф'
! $deck[2] = 'четвёрка треф'
! ...
! $deck[51] = "туз бубей"
! $deck[52] = "джокер красный"
! $deck[53] = "джокер чёрный"

! такой код будет работать быстрее и не потребует дополнительной памяти,
! однако веселее написать заполнение массива на циклах.

! объявляем локальные массивы:
local $suit_, $rank_
! заполняем масти:
$suit_[] = 'треф'
$suit_[] = 'пик'
$suit_[] = 'червей'
$suit_[] = 'бубен'

! заполняем звания:
$rank_[] = 'двойка'
$rank_[] = 'тройка'
$rank_[] = 'четвёрка'
$rank_[] = 'пятёрка'
$rank_[] = 'шестёрка'
$rank_[] = 'семёрка'
$rank_[] = 'восьмёрка'
$rank_[] = 'девятка'
$rank_[] = 'десятка'
$rank_[] = 'валет'
$rank_[] = 'дама'
$rank_[] = 'король'
$rank_[] = 'туз'

! Внешний цикл перебирает масти:
loop local i = 0 while i < arrsize('$suit_') step i += 1:
    ! Внутренний цикл перебирает звания:
    loop local j = 0 while j < arrsize('$rank_') step j += 1:
        ! В колоду вносятся текстовые записи типа "двойка червей" или "туз треф":
        $deck[] = '<<$rank_[j]>> <<$suit_[i]>>'
    end
end

! Не забываем добавить джокеров:
$deck[] = 'джокер красный'
$deck[] = 'джокер чёрный'
---
