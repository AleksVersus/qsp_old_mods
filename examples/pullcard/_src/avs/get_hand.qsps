# crc_get_hand
! Цикл выполняется либо шесть раз, либо (если в колоде меньше шести карт),
! столько раз, сколько карт осталось в колоде:
loop local i, j = 0, -1 while i < 6 and arrsize('$deck')>0 step i+=1:
    ! На каждом проходе получаем случайный номер ячейки массива
    j = rand(0, arrsize('$deck')-1)
    ! Запоминаем карту, где нам нужно. Например, в массиве $hand
    $hand[] = $deck[j]
    ! или выводим название карты на экран:
    *p "<<$deck[j]>>, "
    ! Удаляем элемент из массива $deck (карту из колоды):
    killvar '$deck', j
end
! Делаем перевод строки, чтобы раздачи не сливались в одну:
*pl
---
