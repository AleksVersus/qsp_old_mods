QSP-Game Меню1_код

# Меню1_код
! BASE
*P '! Объявляем локальные переменные с разметкой и названием.
local $game_name_ = '''' & ! сюда помещаем видимое название игры.
local $game_hide_name_ = ''НАЗВАНИЕ ИГРЫ'' & ! сюда помещаем название игры, которое хотим вывести.
! Переменные с открывающими и закрывающими тегами:
local $opens_, $closes_ = ''<center><font size=10>'', ''</font></center>''
! У WladySpb в примере просто набирались символы друг за другом, из-за чего долгое время теги
! оставались не закрытыми. Это ломало отображение страницы и могло привести к багам в других плеерах.

! Цикл, который выводит название игры (и блокирует взаимодействие с ней):
loop local $f while $game_hide_name_:
    ! Вырезаем первую букву из исходного названия:
    $f = $mid($game_hide_name_, 1, 1)
    $game_hide_name_ = $mid($game_hide_name_, 2)
    ! Если мы получили не символ пробела, делаем задержку перед выводом:
    if no ($f = '' '' or $f = ''	''):
        wait 200
    end
    ! Очищаем окно основного описания:
    *clear
    ! Три строки отступаем от верха:
    *nl
    *nl
    *nl
    ! Добавляем букву к видимому названию:
    $game_name_ += $f
    ! выводим разметку и название:
    *pl $opens_ + $game_name_ + $closes_
end
! В локальные переменные разметки записываем новые теги:
$opens_, $closes_ = ''<center><font size=8>'', ''</font></center>''

! Три строки после названия:
*nl
*nl
*nl
! Задержка перед каждым из пунктов меню:
wait 1000
*pl $opens_ + "<a href=""exec:gt ''Начало'' "">НАЧАТЬ ИГРУ</a>" + $closes_

wait 1000
*pl $opens_ + "<a href=""exec:gt ''Начало'' "">Авторы</a>" + $closes_

wait 1000
*pl $opens_ + "<a href=""exec:usehtml=0 & gt''Меню1_код'' "">Показать код</a>" + $closes_'
ACT "В главное меню":
	usehtml = 1
	goto 'гм.Начало'
	$fname = ''
END
! END BASE
USEHTML = 0
showacts 1
$fname = 'Consolas'

-- Меню1_код ---------------------------------

