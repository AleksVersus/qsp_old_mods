1>> <<$a3>>   <<$a1>> <<$a2>> <<$a3>> <<$a2>> <<$a3>> <<$a1>> <<$a2>> <<$a1>> <font size=8><<$a3>></font> <<$a2>> <<$a3>> <<$a1>> <<$a3>> <<$a1>> <<$a1>>  <<$a2>> <<$a3>> <<$a2>> <<$a3>> <<$a1>> <<$a2>> <<$a1>> <<$a3>> <<$a2>> <<$a1>>   <<$a2>> <<$a3>> <<$a2>> <<$a3>> <<$a1>> <<$a2>> <<$a1>> '
