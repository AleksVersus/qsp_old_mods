# гм.Меню5
! если анимация ещё не была запущена, определяем глобальные переменные для хранения данных:
if no $counter:
    ! семь строк ASCII-графики:
    $lines[0] = '                                                                                    '
    $lines[1] = '    #   #  ###  ##### ####   ###  #   # #   # #####    #   # ##### ####  #     #    '
    $lines[2] = '    ##### #   #    ## #   # #   # #   # #  ## #        #  ## #     #   # #     #    '
    $lines[3] = '    #   # #####  ###  ####  ##### ##### # # # ####     # # # #     ####  ####  #    '
    $lines[4] = '    #   # #   #    ## #   # #   # #   # ##  # #        ##  # #     #     #   # #    '
    $lines[5] = '    #   # #   # ##### ####  #   # #   # #   # #####    #   # #     #     ####  #    '
    $lines[6] = '                                                                                    '
    ! ширина строк (84 смивола)Ж
    width = len($lines[0])
    ! число строк
    height = arrsize('$lines')
    ! Количество генерируемых снежинок на каждом проходе цикла:
    stars = 3
    ! Назначаем локацию-счётчик:
    $counter = 'Меню5коунтер'
    settimer 80
end
! основная магия происходит на локации-счётчике.

! здесь же выводим первый кадр
*clr
*p '<font face="Consolas">'
*pl $lines[0]
*pl $lines[1]
*pl $lines[2]
*pl $lines[3]
*pl $lines[4]
*pl $lines[5]
*pl $lines[6]
*p '</font>'
*nl
! выводим пункты меню:
*p '<center><font size=+4>'
"<a href=""exec:$counter='' & gt 'гм.Начало'"">НАЧАТЬ ИГРУ</a>"
*nl
"<a href=""exec:$counter='' & gt 'гм.Код'"">Показать код</a>"
*p '</font></center>'
-- Меню5 ---------------------------------
