QSP-Game Начало

# Начало
! BASE
*P 'Для некоторых игр может потребоваться автоматическое сохранение, т.н. "чекпойнты" - точки сохранения. Чекпойнты полезно применять тогда, когда к этому располагает сюжетная структура игры: повествование разбито на несколько различных неповторяющихся эпизодов. В самом начале каждого из таких эпизодов можно ставить чекпойнт.'
ACT 'Начать игру':
	goto 'чекпойнт1'
END
! END BASE

! отключаем лишние окна
SHOWSTAT 0
SHOWOBJS 0
SHOWINPUT 0

! включаем режим отладки
DEBUG = 1

! Переменная тест отвечает за автоматическую загрузку служебного файла сохранений auto_test.sav.
! Если тест = 0
IF тест = 0:
	! пытаемся загрузить сохранение из файла.
	! Если файл существует, сохранение загрузится.
	! Если файл не существует, плеер проигнорирует команду.
	OPENGAME 'auto_test.sav'
	! После того, как загрузится сохранение, будет выполнен код локации ONGLOAD. Этот код вернёт
	! нас обратно на локацию "Начало".
	! Чтобы данное условие больше не сработало, переменной-маркеру присваиваем единицу:
	тест = 1
END

! Присвоение единицы переменной есть_сейв происходит на локации ONGLOAD.
! Если условие выполнено, нам становится доступно действие "Продолжить игру".
IF есть_сейв = 1:
	ACT 'Продолжить игру':
		! Данное действие загрузит уже непосредственно файл сохранения с чекпоинтом.
		OPENGAME 'auto.sav'
		! Поскольку перед сохранением чекпоинта переменной $ONGLOAD была присвоена
		! пустая строка, код на локации ONGLOAD не выполнится.
	END
END
-- Начало ---------------------------------

