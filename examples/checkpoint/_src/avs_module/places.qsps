
# chpts.place 1
"Локация 1. Здесь сделан чекпоинт."

act 'На локацию 2':
    goto 'chpts.place 2'
end

! Для того, чтобы корректно делать чекпоинт, мы завели отдельную локацию chpts.save_game:
@@chpts.save_game
! Обратите внимание, что сохранять чекпоинт нужно в самом конце, уже после того,
! как весь код на локации будет выполнен.
---

# chpts.place 2
"Локация 2. Здесь не делается чекпоинт."
act 'На локацию 3':
    goto 'chpts.place 3'
end
---

# chpts.place 3
"Локация 3. Здесь сделан чекпоинт."

act 'На локацию 4':
    goto 'chpts.place 4'
end

@@chpts.save_game
---

# chpts.place 4
"Локация 4. Здесь не делается чекпоинт."
act 'На локацию 5':
    goto 'chpts.place 5'
end
---

# chpts.place 5
"Локация 5. Здесь сделан чекпоинт."

act 'На локацию 6':
    goto 'chpts.place 6'
end

@@chpts.save_game
---

# chpts.place 6
"Локация 6. Конец игры."
act 'Сначала':
    killall
    goto 'chpts.start'
end
---
