
# chpts.save_game
! Перед тем, как сделать системное сохранение, присваиваем единицу переменной-маркеру.
! При загрузке сохранения это покажет, что мы загрузили системное сохранение,
! и что нам нужно перезайти на стартовую локацию, чтоб чекпоинт стал доступен:
checkpoint_is_exist = 1
savegame 'system.sav'

! Перед тем, как сделать сохранение чекпоинта, присваиваем ноль переменной-маркеру.
! При загрузке сохранения это покажет, что мы грузимся из файла чекпоинта:
checkpoint_is_exist = 0
savegame 'autosave.sav'
---
