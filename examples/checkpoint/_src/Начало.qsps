QSP-Game Начало

# Начало
! BASE
*P 'Игра с чекпойнтами.'
ACT 'Начать игру':
	goto 'чекпойнт1'
END
! END BASE
SHOWSTAT 0
SHOWOBJS 0
SHOWINPUT 0

DEBUG = 1

IF тест = 0:
	OPENGAME 'auto_test.sav'
	тест = 1
END

IF есть_сейв = 1:
	ACT 'Продолжить игру':
		OPENGAME 'auto.sav'
	END
END
-- Начало ---------------------------------

